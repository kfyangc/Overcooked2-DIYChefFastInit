<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DIYChefFastInit</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">$(OC2_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">D:/Games/Steam Games/steamapps/common/Overcooked! 2</GameDir>
    <ManagedDir>$(GameDir)/Overcooked2_Data/Managed</ManagedDir>
    <FrameworkPathOverride>$(ManagedDir)</FrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Version.cs')), 'Value = &quot;([0-9.]+)&quot;').Groups[1].Value)</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs;Properties/AssemblyInfo.cs" />
    <EmbeddedResource Include="lib/lz4-win-x86.dll" LogicalName="OC2DIYChef.Native.LZ4.x86" />
    <EmbeddedResource Include="third_party/lz4/LICENSE" LogicalName="OC2DIYChef.Native.LZ4.LICENSE" />
    <Reference Include="$(ManagedDir)/mscorlib.dll" Private="false" />
    <Reference Include="$(ManagedDir)/System.dll" Private="false" />
    <Reference Include="$(ManagedDir)/System.Core.dll" Private="false" />
    <Reference Include="$(ManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine*.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony20.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameDirectory" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('lib/lz4-win-x86.dll')" Text="Run powershell -File tools/Fetch-Lz4.ps1 to fetch the pinned LZ4 native dependency." />
    <Error Condition="!Exists('$(ManagedDir)/Assembly-CSharp.dll')" Text="Set GameDir or OC2_GAME_DIR to your Overcooked! 2 installation." />
  </Target>
</Project>
